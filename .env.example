# Copy this file to .env and fill in the real values.
# .env is gitignored and must never be committed.

# Backend (Hugging Face Space or localhost)
VITE_API_URL=https://ngum-alu-chatbot.hf.space

# Firebase project — get these from the Firebase console > Project settings.
# Restrict the API key by HTTP referrer in the Google Cloud console.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Comma-separated list of emails that may unlock the Settings > Advanced tab.
# The user must also be signed in to Firebase as that email.
VITE_ADMIN_EMAILS=d.ngum@alustudent.com,d.ngumadmin@alustudent.com
